# Copy this file to .env and fill in the two Supabase values.
# Leave them empty (or delete .env) to run in Local mode, where data is stored in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only needed for GitHub Pages when the site lives at https://<you>.github.io/<repo>/
# VITE_BASE_PATH=/torah-tracker/

# Optional: a Google Sheet template that users copy (see README, "Live Google Sheet"). Paste the sheet's normal address.
# VITE_SHEET_TEMPLATE_URL=https://docs.google.com/spreadsheets/d/XXXXXXXX/edit
